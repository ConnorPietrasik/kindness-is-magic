# =============================================================================
# Kindness Is Magic — environment
#
# This file ships with committed dev/CI placeholder values that work out of
# the box:
#
#   cp .env.example .env && ./run-compose.sh up --build
#
# Replace the values production needs before deploying. `./run-compose.sh
# prod setup` refuses to run while the production-critical ones (secrets,
# credentials, hostnames, contacts) still match what is committed to
# .env.example — not everything is checked: token lifetimes, email toggles,
# and similar can stay at the defaults shown here.
# =============================================================================

# Postgres credentials and database name for the disposable dev/CI stack.
POSTGRES_USER=kindness-test
POSTGRES_PASSWORD=kindness-test-password
POSTGRES_DB=kindness_is_magic_test

# DB connection pool — the backend auto-sizes from CPU core count (2/core warm,
# equal burst headroom), clamped to Postgres max_connections. Override to tune:
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10

# JWT secrets. For production, generate your own:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=ci-test-secret-0123456789abcdef0123456789abcdef
REFRESH_SECRET_KEY=ci-test-refresh-secret-fedcba9876543210fedcba987654

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Bootstrap admin (created on first startup if not present).
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=CiTestAdmin123!

# Set to "true" in development — insecure cookies, no rate limiting,
# dev-only behavior (also suppresses outgoing email). Keep "false" in production.
DEBUG=true

# Backend log level (DEBUG, INFO, WARNING, ERROR) — default INFO
# LOG_LEVEL=DEBUG

# Invite code lifetime (hours) — default 336 = 14 days
INVITE_EXPIRY_HOURS=336

# Public-facing base URL (used for links in emails) —
# https://<PUBLIC_HOSTNAME> in production.
APP_BASE_URL=http://localhost

# Email (SMTP via fastapi-mail) Gmail requires an App Password
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-email@gmail.com
MAIL_FROM_NAME=Kindness Is Magic
# SUPPRESS_SEND defaults to DEBUG. Uncomment to override:
# SUPPRESS_SEND=0

# Base URL the Playwright e2e suite targets (read by e2e/ helpers from .env).
# Default: http://localhost — the stack on this machine. Uncomment when the
# stack runs elsewhere (e.g. the host PC):
# E2E_BASE_URL=http://192.168.122.1

# --- Zeffy (cash sponsorship payments) ---
# The values below point at the bundled `zeffy-mock` compose
# service (e2e/mock/zeffy_mock.py), so the full cash-sponsorship checkout
# flow works out of the box for local dev and CI without ever touching the
# real, org-rate-limited Zeffy API. For live use, replace them with real
# values from the Zeffy dashboard (Settings → Integrations) and remove
# ZEFFY_API_BASE (it only makes sense for the mock):
#
#   ZEFFY_API_KEY         org API key (Integrations → API key)
#   ZEFFY_FORM_URL        public URL of the dedicated sponsorship donation form
#                         (the donor enters the total manually — Zeffy can't
#                         pre-fill the amount via URL) — when the stack runs on
#                         another machine, use that machine's host:port (the
#                         mock's port 8931 is published on it)
#   ZEFFY_CAMPAIGN_ID     UUID of that form's campaign (dashboard, or one
#                         GET /api/v1/campaigns call)
#   ZEFFY_WEBHOOK_SECRET  whsec_... from Integrations → Webhook (after
#                         registering the webhook URL; rotating the secret in
#                         Zeffy kills the old one — re-copy after any rotation)
ZEFFY_API_KEY=e2e-mock-zeffy-key
ZEFFY_FORM_URL=http://localhost:8931/form
ZEFFY_CAMPAIGN_ID=11111111-1111-4111-8111-111111111111
ZEFFY_WEBHOOK_SECRET=
# The app's own donor-facing "payment confirmed" email — off by default:
# Zeffy already emails the donor a receipt/confirmation for the same
# payment, and a second "payment received" email from the app tends to
# confuse. Set to true to send it on top of Zeffy's receipt:
SEND_PAYMENT_CONFIRMED_EMAIL=false
# Where the backend reaches the Zeffy API — the mock, by compose
# service name (only resolvable inside the dev stack's network). Unset in
# real deployments; defaults to https://api.zeffy.com.
ZEFFY_API_BASE=http://zeffy-mock:8931
# 0 = no throttle between outbound Zeffy calls (the mock has no quota
# to be a good citizen for). Leave unset when using real credentials to keep
# the default ~3s spacing.
ZEFFY_MIN_INTERVAL_SECONDS=0

# --- Production (docker-compose.prod.yml) ---
# Public domain with a DNS A record pointing at this server, plus a "www"
# CNAME at the apex (www is 301-redirected; both names share the cert).
# Used for Traefik routing and the Let's Encrypt certificate.
PUBLIC_HOSTNAME=your-domain.com

# Let's Encrypt contact address (receives expiry notices).
LETSENCRYPT_EMAIL=you@example.com

# Automatic backups (the `backups` service in docker-compose.prod.yml):
# daily pg_dump at 03:00 America/Los_Angeles into ./backups; dumps older than
# this many days are deleted.
BACKUP_KEEP_DAYS=7
